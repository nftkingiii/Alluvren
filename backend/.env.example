PORT=8787
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
DEC_MAN_URLS=p1=http://localhost:8081,p2=http://localhost:8082,p3=http://localhost:8083
GOVERNANCE_PARTY_ID=replace-with-governance-party
RULES_CONTRACT_ID=replace-with-governance-rules-contract
ALLUVREN_PACKAGE_REF="#alluvren-v1"
ENVIRONMENT=LocalNet

# Gate 8: sign-in and ledger writes
# Path to the accounts file (see accounts.example.json). Keep it out of git.
ACCOUNTS_FILE=./accounts.json
# JSON Ledger APIs of the participants hosting the business parties, primary
# first (LocalNet: node 2, then node 1 as backup). Reads and not-yet-submitted
# commands fail over to the next one; participants reporting no connected
# synchronizer are used last. The token stays server-side.
LEDGER_JSON_API_URL=http://localhost:2975,http://localhost:3975
LEDGER_TOKEN=replace-with-localnet-ledger-token
LEDGER_USER_ID=ledger-api-user
# Ledger and governance writes are off unless this is exactly "true".
WRITES_ENABLED=false
# Set to true when serving over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false
RATE_LIMIT_PER_MINUTE=60
