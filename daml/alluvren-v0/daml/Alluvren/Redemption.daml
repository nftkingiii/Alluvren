module Alluvren.Redemption where

import DA.Action (void, when)
import DA.Foldable (forA_, maximum)
import DA.List (unique, dedup)
import DA.Optional (fromOptional, isSome)
import Alluvren.Allocation
import Alluvren.Claims
import Alluvren.Sealed
import Governance.Action
import Splice.Util (require)

-- The business roles are deliberately explicit. BitSafe's member threshold is
-- a separate control exercised by GovernanceRules around FinalizeRedemption.
data ApprovalRole
  = FundReviewer
  | TreasuryReviewer
  | ComplianceReviewer
  | AdministratorCheck
  | FinalSignoff
  deriving (Eq, Show)

data AllocationRow = AllocationRow
  with
    requestId : Text
    investor : Party
    requestedUnits : Int
    allocatedUnits : Int
  deriving (Eq, Show)

data RedemptionStatus
  = BatchFrozen
  | BatchFinalized
  deriving (Eq, Show)

data ApprovalTarget = ApprovalTarget
  with
    batchCid : ContractId RedemptionBatch
    batchId : Text
    policyVersion : Text
  deriving (Eq, Show)

data FinalizationRecord = FinalizationRecord
  with
    batchId : Text
    policyVersion : Text
    totalRequested : Int
    totalAllocated : Int
    finalizedAt : Time
  deriving (Eq, Show)

-- A reviewer signs an approval. The governance party can consume it during
-- finalization because it is an observer and the choice is governance-party
-- controlled; the reviewer is still authenticated by the signatory field.
template RoleApproval
  with
    governanceParty : Party
    reviewer : Party
    role : ApprovalRole
    target : ApprovalTarget
    expiresAt : Time
  where
    signatory reviewer
    observer governanceParty

    ensure reviewer /= governanceParty
        && target.batchId /= ""

    choice RoleApproval_Consume : RoleApproval
      controller governanceParty
      do
        now <- getTime
        require "Role approval has expired" (now < expiresAt)
        pure this

    choice RoleApproval_Revoke : ()
      controller reviewer
      do pure ()

-- This is an immutable, frozen allocation. It is intentionally not a token or
-- bank balance: the MVP proves governed decision-making before settlement.
template RedemptionBatch
  with
    governanceParty : Party
    proposer : Party
    operator : Party
    fundReviewer : Party
    treasuryReviewer : Party
    policyVersion : Text
    batchId : Text
    rows : [AllocationRow]
    totalRequested : Int
    totalAllocated : Int
    recoveryDeadline : Time
    -- Policy batches (0.3.0+) pin a FundPolicy and must be finalized with
    -- RedemptionBatch_FinalizeWithPolicy. For them, fundReviewer and
    -- treasuryReviewer are informational only. None = legacy two-reviewer rule.
    policyCid : Optional (ContractId FundPolicy)
    policyMembers : Optional [Party]
    exceptions : Optional [ExceptionNote]
    -- Sealed batches (0.4.0+) carry no rows: governance approves totals and a
    -- commitment, and the rows stay in the operator's AllocationBook (see
    -- Alluvren.Sealed). They need a fund policy and proposer == operator.
    sealed : Optional SealedSummary
  where
    signatory proposer
    observer governanceParty, operator, fundReviewer, treasuryReviewer, fromOptional [] policyMembers

    ensure batchId /= ""
        && policyVersion /= ""
        && proposer /= governanceParty
        && operator /= governanceParty
        && fundReviewer /= treasuryReviewer
        && proposer /= fundReviewer
        && proposer /= treasuryReviewer
        && fundReviewer /= governanceParty
        && treasuryReviewer /= governanceParty
        && totalRequested >= 0
        && totalRequested <= 1000000000
        && totalAllocated >= 0
        && totalAllocated <= totalRequested
        && isSome policyCid == isSome policyMembers
        && (case sealed of
          None ->
            not (null rows)
              && all (\r -> r.requestId /= "" && r.requestedUnits > 0
                && r.allocatedUnits >= 0 && r.allocatedUnits <= r.requestedUnits) rows
              && totalAllocated == sum (map (.allocatedUnits) rows)
              && totalRequested == sum (map (.requestedUnits) rows)
              && unique (map (.requestId) rows)
              && validAllocation totalRequested totalAllocated rows
          Some summary ->
            null rows
              && totalRequested > 0
              && isSome policyCid
              && proposer == operator
              && validSummary totalAllocated summary)

    choice RedemptionBatch_Finalize : FinalizationRecord
      with
        fundApprovalCid : ContractId RoleApproval
        treasuryApprovalCid : ContractId RoleApproval
      controller governanceParty
      do
        now <- getTime
        require "Batch execution deadline has passed" (now < recoveryDeadline)
        require "Batch is governed by a fund policy; use FinalizeWithPolicy" (policyCid == None)
        require "A reviewer is an investor in this batch"
          (notElem fundReviewer (batchInvestors rows) && notElem treasuryReviewer (batchInvestors rows))
        fundApproval <- exercise fundApprovalCid RoleApproval_Consume
        treasuryApproval <- exercise treasuryApprovalCid RoleApproval_Consume
        require "Fund approval targets the wrong batch"
          (fundApproval.target == ApprovalTarget with batchCid = self; batchId; policyVersion)
        require "Treasury approval targets the wrong batch"
          (treasuryApproval.target == ApprovalTarget with batchCid = self; batchId; policyVersion)
        require "Approval governance party mismatch"
          (fundApproval.governanceParty == governanceParty
            && treasuryApproval.governanceParty == governanceParty)
        require "Fund reviewer approval is not from the configured reviewer"
          (fundApproval.reviewer == fundReviewer && fundApproval.role == FundReviewer)
        require "Treasury reviewer approval is not from the configured reviewer"
          (treasuryApproval.reviewer == treasuryReviewer
            && treasuryApproval.role == TreasuryReviewer)
        require "Approvals must come from distinct parties"
          (fundApproval.reviewer /= treasuryApproval.reviewer)
        -- The batch is consumed by this choice, so investor records are
        -- created exactly once.
        createInvestorRecords governanceParty batchId policyVersion rows
        pure FinalizationRecord with
          batchId
          policyVersion
          totalRequested
          totalAllocated
          finalizedAt = now

    -- Policy-governed finalization: required roles come from the pinned
    -- FundPolicy plus any conditional requirement triggered by this batch.
    choice RedemptionBatch_FinalizeWithPolicy : FinalizationRecord
      with
        approvalCids : [ContractId RoleApproval]
      controller governanceParty
      do
        now <- getTime
        require "Batch execution deadline has passed" (now < recoveryDeadline)
        pinned <- case policyCid of
          None -> abort "Batch has no fund policy; use RedemptionBatch_Finalize"
          Some cid -> pure cid
        -- Fails if the policy was superseded: a rule change needs a new batch.
        policy <- fetch pinned
        require "Policy governance party mismatch" (policy.governanceParty == governanceParty)
        require "Policy operator mismatch" (policy.operator == operator)
        require "Batch policy version does not match the pinned policy"
          (policyVersion == policyVersionLabel policy)
        require "Batch observers do not match the policy members"
          (policyMembers == Some (policyMemberSet policy))
        require "Duplicate approval contract" (unique approvalCids)
        approvals <- forA approvalCids \cid -> exercise cid RoleApproval_Consume
        let target = ApprovalTarget with batchCid = self; batchId; policyVersion
            approvers = map (.reviewer) approvals
            required = effectiveRequirements policy this
        require "Approval targets the wrong batch" (all (\a -> a.target == target) approvals)
        require "Approval governance party mismatch"
          (all (\a -> a.governanceParty == governanceParty) approvals)
        require "A party approved more than once or under more than one role" (unique approvers)
        require "An approver is an investor in this batch"
          (not (any (`elem` batchInvestors rows) approvers))
        require "An approver is the proposer or operator"
          (not (any (\p -> p == proposer || p == operator) approvers))
        forA_ approvals \a ->
          require "Approval is not from a member of a role this batch requires"
            (any (\r -> r.role == a.role && elem a.reviewer r.members) required)
        forA_ required \r ->
          require ("Missing required approvals for role " <> show r.role)
            (length (filter (\a -> a.role == r.role) approvals) >= r.quorum)
        case sealed of
          None -> createInvestorRecords governanceParty batchId policyVersion rows
          -- The operator's AllocationBook is checked against this when opened.
          Some summary -> void $ create SealedFinalization with
            governanceParty
            operator
            batchId
            policyVersion
            totalRequested
            totalAllocated
            summary
            approvers
            finalizedAt = now
        pure FinalizationRecord with
          batchId
          policyVersion
          totalRequested
          totalAllocated
          finalizedAt = now

    choice RedemptionBatch_RecoverExpired : ()
      controller operator
      do
        now <- getTime
        require "Batch recovery deadline has not passed" (now >= recoveryDeadline)

batchInvestors : [AllocationRow] -> [Party]
batchInvestors = map (.investor)

-- Each investor receives private records for its own row only.
createInvestorRecords : Party -> Text -> Text -> [AllocationRow] -> Update ()
createInvestorRecords governanceParty batchId policyVersion rows =
  forA_ rows \r -> do
    when (r.allocatedUnits > 0) do
      void $ create ClaimEntitlement with
        governanceParty
        investor = r.investor
        batchId
        policyVersion
        requestId = r.requestId
        units = r.allocatedUnits
    let outstanding = r.requestedUnits - r.allocatedUnits
    when (outstanding > 0) do
      void $ create OutstandingRedemption with
        governanceParty
        investor = r.investor
        batchId
        policyVersion
        requestId = r.requestId
        units = outstanding

-- Largest remainder allocation (Alluvren.Allocation).
validAllocation : Int -> Int -> [AllocationRow] -> Bool
validAllocation requested allocated rows =
  largestRemainderValid requested allocated (map (\r -> (r.requestId, r.requestedUnits, r.allocatedUnits)) rows)

-- DecMan discovers this proposal through Governance.Action. GovernanceRules
-- confirms and executes it by ContractId; BitSafe threshold approval is outside
-- this template and remains independently enforced by GovernanceRules.
template FinalizeRedemption
  with
    governanceParty : Party
    proposer : Party
    batchCid : ContractId RedemptionBatch
    fundApprovalCid : ContractId RoleApproval
    treasuryApprovalCid : ContractId RoleApproval
    description : Text
  where
    signatory proposer
    observer governanceParty

    interface instance GovernableAction for FinalizeRedemption where
      view = GovernableActionView with
        governanceParty
        proposer
        actionLabel = "FinalizeRedemption"
        description

      executeImpl = do
        _ <- exercise batchCid RedemptionBatch_Finalize with
          fundApprovalCid
          treasuryApprovalCid
        pure ()

-- ---------------------------------------------------------------------------
-- Policy-driven role governance (0.3.0). Types live in this module because
-- RedemptionBatch pins a FundPolicy and the policy uses ApprovalRole.

data ExceptionNote = ExceptionNote
  with
    requestId : Text
    note : Text
  deriving (Eq, Show)

-- N-of-M distinct members of one role.
data RoleRequirement = RoleRequirement
  with
    role : ApprovalRole
    members : [Party]
    quorum : Int
  deriving (Eq, Show)

-- Facts computed from the batch itself, in integer basis points.
data Trigger
  = FundedBelowBps Int
    -- ^ totalAllocated / totalRequested is strictly below this share.
  | InvestorShareAboveBps Int
    -- ^ One investor receives strictly more than this share of allocated units.
  | ExceptionsPresent
    -- ^ The batch carries at least one exception note.
  deriving (Eq, Show)

data ConditionalRequirement = ConditionalRequirement
  with
    trigger : Trigger
    requirement : RoleRequirement
  deriving (Eq, Show)

-- The approval policy for one fund. Created and replaced only through
-- UpdateFundPolicy, i.e. behind the BitSafe threshold.
template FundPolicy
  with
    governanceParty : Party
    operator : Party
    fundId : Text
    version : Int
    base : [RoleRequirement]
    conditional : [ConditionalRequirement]
  where
    signatory governanceParty
    observer operator, policyMemberSet this

    ensure validPolicy this

    -- Consuming; batches pinned to this contract can no longer finalize.
    choice FundPolicy_Supersede : ()
      controller governanceParty
      do pure ()

-- Equality-only uniqueness (ApprovalRole has no Ord instance; adding one is
-- avoided to keep the upgraded type unchanged).
allDistinct : Eq a => [a] -> Bool
allDistinct xs = length (foldl (\acc x -> if elem x acc then acc else x :: acc) [] xs) == length xs

validRequirement : Party -> Party -> RoleRequirement -> Bool
validRequirement governanceParty operator r =
  r.quorum >= 1
    && r.quorum <= length r.members
    && unique r.members
    && notElem governanceParty r.members
    && notElem operator r.members

validTrigger : Trigger -> Bool
validTrigger (FundedBelowBps bps) = bps >= 1 && bps <= 10000
validTrigger (InvestorShareAboveBps bps) = bps >= 0 && bps < 10000
validTrigger ExceptionsPresent = True

validPolicy : FundPolicy -> Bool
validPolicy p =
  let baseRoles = map (.role) p.base
      -- A conditional requirement for a base role must name the same members;
      -- it can only raise that role's quorum.
      consistentWithBase c = case filter (\r -> r.role == c.requirement.role) p.base of
        [] -> True
        (b :: _) -> b.members == c.requirement.members
  in p.fundId /= ""
    && p.version >= 1
    && p.operator /= p.governanceParty
    && not (null p.base)
    && allDistinct baseRoles
    && all (validRequirement p.governanceParty p.operator) p.base
    && all (\c -> validTrigger c.trigger
          && validRequirement p.governanceParty p.operator c.requirement
          && consistentWithBase c) p.conditional

policyVersionLabel : FundPolicy -> Text
policyVersionLabel p = p.fundId <> "@v" <> show p.version

policyMemberSet : FundPolicy -> [Party]
policyMemberSet p =
  dedup (concatMap (.members) p.base <> concatMap (\c -> c.requirement.members) p.conditional)

triggerHolds : RedemptionBatch -> Trigger -> Bool
triggerHolds b (FundedBelowBps bps) = b.totalAllocated * 10000 < bps * b.totalRequested
triggerHolds b (InvestorShareAboveBps bps) =
  b.totalAllocated > 0
    && case b.sealed of
      None -> any (\r -> r.allocatedUnits * 10000 > bps * b.totalAllocated) b.rows
      -- Checked against the real rows when the AllocationBook is opened.
      Some summary -> summary.maxRowAllocatedUnits * 10000 > bps * b.totalAllocated
triggerHolds b ExceptionsPresent = not (null (fromOptional [] b.exceptions))

-- Base requirements plus every triggered conditional requirement, merged per
-- role by taking the highest quorum.
effectiveRequirements : FundPolicy -> RedemptionBatch -> [RoleRequirement]
effectiveRequirements p b =
  let triggered = map (.requirement) (filter (\c -> triggerHolds b c.trigger) p.conditional)
      allReqs = p.base <> triggered
      roles = foldl (\acc r -> if elem r.role acc then acc else acc <> [r.role]) [] allReqs
      merge role =
        let same = filter (\r -> r.role == role) allReqs
        in case same of
          [] -> error "unreachable"
          (first :: _) -> first with quorum = maximum (map (.quorum) same)
  in map merge roles

-- Creates the first policy (currentPolicyCid = None) or replaces the current
-- one with version + 1. Executed only through BitSafe GovernanceRules.
template UpdateFundPolicy
  with
    governanceParty : Party
    proposer : Party
    currentPolicyCid : Optional (ContractId FundPolicy)
    newPolicy : FundPolicy
    description : Text
  where
    signatory proposer
    observer governanceParty

    interface instance GovernableAction for UpdateFundPolicy where
      view = GovernableActionView with
        governanceParty
        proposer
        actionLabel = "UpdateFundPolicy"
        description

      executeImpl = do
        require "Replacement policy governance party mismatch"
          (newPolicy.governanceParty == governanceParty)
        case currentPolicyCid of
          None -> require "Initial policy must be version 1" (newPolicy.version == 1)
          Some cid -> do
            -- Fails if another update already superseded this policy.
            current <- fetch cid
            require "Replacement policy is for a different fund" (newPolicy.fundId == current.fundId)
            require "Replacement policy must be the next version"
              (newPolicy.version == current.version + 1)
            exercise cid FundPolicy_Supersede
        void $ create newPolicy

-- Governed proposal for policy batches.
template FinalizePolicyRedemption
  with
    governanceParty : Party
    proposer : Party
    batchCid : ContractId RedemptionBatch
    approvalCids : [ContractId RoleApproval]
    description : Text
  where
    signatory proposer
    observer governanceParty

    interface instance GovernableAction for FinalizePolicyRedemption where
      view = GovernableActionView with
        governanceParty
        proposer
        actionLabel = "FinalizePolicyRedemption"
        description

      executeImpl = do
        _ <- exercise batchCid RedemptionBatch_FinalizeWithPolicy with approvalCids
        pure ()
